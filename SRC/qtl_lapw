# ============================================================
#  Summary
# ============================================================
echo
echo -e "${BOLD}QTL-guided workflow completed successfully${NC}"
echo
echo "  Output files:"
echo "    $file.amn             projection matrix"
echo "    $file.mmn             overlap matrix"
echo "    $file.eig             eigenvalues"
echo "    $file.win             Wannier90 input (QTL-patched)"
echo "    ${file}_hr.dat        Hamiltonian in WF basis"
[[ -s ${file}_band.dat ]] && \
echo "    ${file}_band.dat      interpolated band structure"
