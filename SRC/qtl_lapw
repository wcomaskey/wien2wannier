# ============================================================
if [[ -s $file.spaghetti_ene && -s ${file}_band.dat ]]; then
    step "6" "Generating band comparison plot"
    if [[ -x "$bin/compare_bands.py" ]]; then
        python3 "$bin/compare_bands.py" "$file" -dir . 2>&1
    fi
