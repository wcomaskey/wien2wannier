#!/bin/bash

### wien2wannier/SRC/pdwf_lapw
###
###    Automated PDWF (Projectability-Disentangled Wannier Functions)
###    workflow for wien2wannier.
###
###    Self-contained pipeline — does NOT depend on Wien2k's x_lapw.
###    Calls w2w/w2wc and wannier90.x directly, so they can be built
###    with independent toolchains (important on HPC where Wien2k and
###    Wannier90 may have competing MPI/BLAS dependencies).
###
###    Pipeline:
###      1. Generate PDWF .inwf
###      2. Generate initial .win (real k-points, dummy num_wann)
###      3. Run wannier90.x -pp  →  .nnkp
###      4. Run w2wc PDWF mode   →  .amn, .mmn, .eig + patches .win
###      5. Run wannier90.x      →  Wannierization
###
### Copyright 2024 William Comaskey

bin=$(cd "$(dirname "$0")" && pwd)
name=$(basename "$0")
file=$(basename "$PWD")

usage() {
    cat <<EOF
PROGRAM:    $name

PURPOSE:    Automated PDWF workflow for wien2wannier.
            Generates projections, energy windows, and Wannier functions
            automatically from a completed Wien2k calculation.

            Does NOT require Wien2k's x_lapw — calls executables directly.

USAGE:      $name [FLAGS] [OPTIONS]

FLAGS:
  -h,-H       this message
  -v          verbose output
  -q          quiet mode
  -up/-dn     spin-polarized
  -so         spin-orbit coupling
  -norun      stop after generating .inwf and .win (dry run)
  -nommn      skip MMN computation (AMN only, for testing)

OPTIONS:
  -f CASE       override case name (default: directory name)
  -bmin N       minimum band index (default: auto from energy file)
  -bmax N       maximum band index (default: auto from energy file)
  -ljmax N      max L for exp(ibr) expansion (default: 5)
  -phigh X      projectability threshold for frozen bands (default: 0.90)
  -plow X       projectability threshold for exclusion (default: 0.05)
  -margin X     energy margin for windows in eV (default: 0.50)
  -nkband N     k-points per band path segment (default: 100)
  -w2wdir DIR   directory containing w2w/w2wc executables
  -w90exe EXE   path to wannier90.x executable

PREREQUISITES:
  A completed Wien2k SCF calculation providing:
    case.struct   case.klist     case.energy
    case.vector   case.vsp       case.fermi

EXECUTABLE SEARCH ORDER:
  w2w/w2wc:     -w2wdir  >  \$bin/../SRC_w2w  >  \$bin  >  \$PATH
  wannier90.x:  -w90exe  >  \$PATH (wannier90.x, then wannier90)

EXAMPLES:
  $name                                             # fully automatic
  $name -bmin 5 -bmax 22                            # explicit band window
  $name -so                                         # spin-orbit
  $name -w2wdir ./SRC_w2w -w90exe ./wannier90.x     # explicit paths
  $name -norun                                      # generate files only
  $name -phigh 0.80 -plow 0.1                       # custom thresholds
EOF
}

croak() { echo >&2 "$name: $*"; exit 1; }
warn()  { [[ $q ]] && return; echo >&2 "$name: $*"; }
info()  { [[ $q ]] && return; echo "  $*"; }

# ============================================================
#  Parse options
# ============================================================
unset v q updn so norun nommn
bmin=""
bmax=""
ljmax=5
phigh=0.60
plow=0.15
margin=0.50
nkband=100
w2wdir=""
w90exe=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -[hH]|-help|--help) usage; exit 0;;
        -v|-verbose) v=1;;
        -q|-quiet)   q=1;;
        -up)    updn=up;;
        -dn)    updn=dn;;
        -so)    so=so;;
        -noso)  unset so;;
        -norun) norun=1;;
        -nommn) nommn=1;;
        -f)      shift; file=$1;;
        -bmin)   shift; bmin=$1;;
        -bmax)   shift; bmax=$1;;
        -ljmax)  shift; ljmax=$1;;
        -phigh)  shift; phigh=$1;;
        -plow)   shift; plow=$1;;
        -margin) shift; margin=$1;;
        -nkband) shift; nkband=$1;;
        -w2wdir) shift; w2wdir=$1;;
        -w90exe) shift; w90exe=$1;;
        -*) croak "unknown option \`$1' (try -h)";;
        *)  croak "unexpected argument \`$1'";;
    esac
    shift
done

# ============================================================
#  Detect calculation type
# ============================================================
w2w_exec="w2wc"  # default to complex (safe choice)

if [[ -s $file.in1c || -n $so ]]; then
    w2w_exec="w2wc"
elif [[ -s $file.in1 && ! -s $file.in1c ]]; then
    w2w_exec="w2w"
fi

if [[ -s $file.inso ]]; then
    so=so
fi

[[ $v ]] && info "case=$file w2w=$w2w_exec sp=${updn:-none} so=${so:-no}"

# ============================================================
#  Resolve executables (no x_lapw dependency)
# ============================================================
resolve_w2w() {
    local exe=$1
    # Search order: -w2wdir > $bin/../SRC_w2w > $bin > $PATH
    for dir in "$w2wdir" "$bin/../SRC_w2w" "$bin"; do
        [[ -n $dir && -x "$dir/$exe" ]] && { echo "$dir/$exe"; return 0; }
    done
    command -v "$exe" 2>/dev/null && return 0
    return 1
}

resolve_w90() {
    # Search order: -w90exe > $PATH
    if [[ -n $w90exe && -x "$w90exe" ]]; then
        echo "$w90exe"; return 0
    fi
    command -v wannier90.x 2>/dev/null && return 0
    command -v wannier90   2>/dev/null && return 0
    return 1
}

# Resolve now but only error later when actually needed
W2W_BIN=$(resolve_w2w "$w2w_exec") || true
W90_BIN=$(resolve_w90) || true

[[ $v ]] && info "w2w executable:  ${W2W_BIN:-(not found)}"
[[ $v ]] && info "w90 executable:  ${W90_BIN:-(not found)}"

# ============================================================
#  Validate prerequisites
# ============================================================
for f in $file.struct $file.klist; do
    [[ -s $f ]] || croak "required file \`$f' not found (run Wien2k first)"
done

# Energy file: try suffixed variants, then plain
enefile=""
for suffix in "${so}${updn}" "${updn}" ""; do
    [[ -s "$file.energy$suffix" ]] && { enefile="$file.energy$suffix"; break; }
done
[[ -n $enefile ]] || croak "energy file not found (need case.energy)"

# Vector file
vecfile=""
for suffix in "${so}${updn}" "${updn}" ""; do
    [[ -s "$file.vector$suffix" ]] && { vecfile="$file.vector$suffix"; break; }
done
[[ -n $vecfile ]] || croak "vector file not found"

# Potential file
vspfile=""
for suffix in "${updn}" ""; do
    [[ -s "$file.vsp$suffix" ]] && { vspfile="$file.vsp$suffix"; break; }
done
[[ -n $vspfile ]] || croak "potential file not found"

# Fermi energy
fermifile=$file.fermi
if [[ ! -s $fermifile ]]; then
    if [[ -s $file.scf ]]; then
        grep ':FER' "$file.scf" | tail -1 | awk '{print $NF}' > "$fermifile"
        info "extracted Fermi energy from $file.scf"
    else
        croak "Fermi energy file \`$fermifile' not found"
    fi
fi

[[ $v ]] && info "energy=$enefile vector=$vecfile vsp=$vspfile"

# ============================================================
#  Step 0: Auto-detect band window if not specified
# ============================================================
if [[ -z $bmin || -z $bmax ]]; then
    info "auto-detecting band window from $enefile ..."

    # Parse energy file: skip 2*Nneq header lines, then read first k-point
    read_bands=$(awk '
    BEGIN { nneq=0; state=0 }
    state==0 { nneq++; if(NR==2) state=1; next }
    state==1 { nneq++; state=2; next }
    state==2 {
        n = substr($0, 74, 6) + 0
        printf "%d\n", n
        exit
    }
    ' "$enefile")

    [[ -z $read_bands || $read_bands -eq 0 ]] && \
        croak "could not determine number of bands from $enefile"

    [[ -z $bmin ]] && bmin=1
    [[ -z $bmax ]] && bmax=$read_bands

    info "detected $read_bands bands, using window [$bmin, $bmax]"
fi

nb=$((bmax - bmin + 1))

# ============================================================
#  Step 1: Generate PDWF .inwf file
# ============================================================
info "Step 1: Generating PDWF .inwf"

inwffile=$file.inwf${updn}
cat > "$inwffile" <<EOF
PDWF
 $bmin  $bmax
 $ljmax
 $phigh  $plow  $margin
EOF

[[ $v ]] && cat "$inwffile"
info "wrote $inwffile"

# ============================================================
#  Step 1b: Generate dense klist_band (if klist_band exists)
# ============================================================
klistband=$file.klist_band
if [[ -s $klistband ]]; then
    info "Step 1b: Generating dense klist_band ($nkband pts/segment)"
    python3 - "$file" "$nkband" <<'KBEOF'
import sys, re
import numpy as np

case = sys.argv[1]
npts = int(sys.argv[2])

# Read existing klist_band — extract labeled high-symmetry points
labels = []
with open(f"{case}.klist_band") as f:
    for line in f:
        s = line.strip()
        if s == 'END' or not s:
            continue
        label = line[0:10].strip()
        if not label or label.replace('-','').replace('.','').isdigit():
            continue
        body = line[10:].split()
        if len(body) < 4:
            continue
        ix, iy, iz, idv = int(body[0]), int(body[1]), int(body[2]), int(body[3])
        labels.append((label, np.array([ix/idv, iy/idv, iz/idv])))

if len(labels) < 2:
    print(f"  klist_band has {len(labels)} labels, skipping densification")
    sys.exit(0)

# Find a common divisor that gives integer coords for all points
# Use LCM of all original divisors, scaled to npts
div = npts * 6  # 6 covers 1/2, 1/3, 1/4, 1/6 etc.

# Write dense klist_band
# Back up original
import shutil
shutil.copy(f"{case}.klist_band", f"{case}.klist_band.orig")

with open(f"{case}.klist_band", 'w') as f:
    for iseg in range(len(labels) - 1):
        l1, k1 = labels[iseg]
        l2, k2 = labels[iseg + 1]

        for i in range(npts + 1):
            if i == 0 and iseg > 0:
                continue  # skip duplicate at boundary
            t = i / npts
            kp = k1 + t * (k2 - k1)
            ix = int(round(kp[0] * div))
            iy = int(round(kp[1] * div))
            iz = int(round(kp[2] * div))

            if (i == 0) or (i == npts and iseg == len(labels) - 2):
                lbl = l1 if i == 0 else l2
                erange = '-8.00 8.00' if (iseg == 0 and i == 0) else ''
                f.write(f"{lbl:10s}{ix:5d}{iy:5d}{iz:5d}{div:5d}  2.0{erange}\n")
            elif i == npts:
                f.write(f"{l2:10s}{ix:5d}{iy:5d}{iz:5d}{div:5d}  2.0\n")
            else:
                f.write(f"{'':10s}{ix:5d}{iy:5d}{iz:5d}{div:5d}  2.0\n")
    f.write("END\n")

total = sum(1 for _ in open(f"{case}.klist_band") if _.strip() and _.strip() != 'END')
print(f"  wrote {case}.klist_band: {total} k-points, {npts} per segment")
KBEOF
fi

# ============================================================
#  Step 2: Generate initial .win file
# ============================================================
info "Step 2: Generating initial .win"

winfile=$file.win

# Generate .win from Wien2k files (struct + klist + klist_band)
# Uses dummy num_wann = num_bands (PDWF will patch the real value)
python3 - "$file" "$bmin" "$bmax" <<'PYEOF'
import sys, os, re, math
import numpy as np

case = sys.argv[1]
bmin, bmax = int(sys.argv[2]), int(sys.argv[3])
nb = bmax - bmin + 1

# ----- Parse struct file -----
with open(f"{case}.struct") as f:
    slines = f.readlines()

lattype = slines[1][0:1].strip()
# nneq: Wien2k uses "NONEQUIV.ATOMS:  2" or "NONEQUIV.ATOMS   2"
nneq_match = re.search(r'ATOMS[:\s]+(\d+)', slines[1])
nneq = int(nneq_match.group(1)) if nneq_match else int(slines[1].split()[3])
latline = slines[3]
a = [float(latline[i:i+10]) for i in range(0, 60, 10)]

# Parse atoms (inequivalent only)
# Wien2k struct format per inequivalent atom:
#   ATOM line (position)        1 line
#   MULT line                   1 line
#   equiv atom positions        (mult-1) lines
#   element/RMT line            1 line
#   LOCAL ROT MATRIX            3 lines
atoms = []
i = 4
for iat in range(nneq):
    pos = slines[i]
    x = float(pos[12:22])
    y = float(pos[25:35])
    z = float(pos[38:48])
    i += 1  # now on MULT line
    mult = int(slines[i].split('=')[1].split()[0])
    i += 1  # past MULT line
    i += (mult - 1)  # skip equivalent atom position lines
    i += 1  # element/RMT line
    i += 3  # LOCAL ROT MATRIX (3 lines)
    atoms.append((iat + 1, x, y, z, mult))

# ----- Primitive lattice vectors (Bohr) -----
a1, a2, a3 = a[0], a[1], a[2]
alpha = a[3] * math.pi / 180
beta  = a[4] * math.pi / 180
gamma = a[5] * math.pi / 180

if lattype == 'F':
    prim = [[0, a2/2, a3/2], [a1/2, 0, a3/2], [a1/2, a2/2, 0]]
elif lattype == 'B':
    prim = [[-a1/2, a2/2, a3/2], [a1/2, -a2/2, a3/2], [a1/2, a2/2, -a3/2]]
elif lattype == 'H':
    prim = [[a1, 0, 0], [-a1/2, a2*math.sqrt(3)/2, 0], [0, 0, a3]]
elif lattype == 'R':
    tx = a1 * math.sqrt((1 - math.cos(alpha)) / 2)
    tz = a1 * math.sqrt((1 + 2 * math.cos(alpha)) / 3)
    ty1 = a1 * math.sqrt((1 - math.cos(alpha)) / 6)
    prim = [[tx, -ty1, tz/3], [0, 2*ty1, tz/3], [-tx, -ty1, tz/3]]
elif lattype == 'C':
    # CXY, CXZ, CYZ — Wien2k uses different subtypes
    prim = [[a1/2, -a2/2, 0], [a1/2, a2/2, 0], [0, 0, a3]]
else:  # P
    sg = math.sin(gamma)
    cg = math.cos(gamma)
    cb = math.cos(beta)
    ca = math.cos(alpha)
    prim = [
        [a1, 0, 0],
        [a2*cg, a2*sg, 0],
        [a3*cb, a3*(ca - cb*cg)/sg,
         a3*math.sqrt(1 - ca**2 - cb**2 - cg**2 + 2*ca*cb*cg)/sg]
    ]

# ----- Parse klist for k-mesh -----
# Wien2k klist format varies: 5-char or 10-char integer fields.
# Robust approach: split on whitespace after the 10-char label.
kpoints = []
mp_grid = [1, 1, 1]
with open(f"{case}.klist") as f:
    for line in f:
        s = line.strip()
        if s.startswith('END') or len(s) == 0:
            break
        # First line may contain "k, div: ( nx ny nz )"
        div_match = re.search(r'div:\s*\(\s*(\d+)\s+(\d+)\s+(\d+)\s*\)', line)
        if div_match:
            mp_grid = [int(div_match.group(i)) for i in (1, 2, 3)]
        # Parse k-point: label(10) then integers
        body = line[10:].split()
        if len(body) < 4:
            continue
        try:
            ix, iy, iz, idv = int(body[0]), int(body[1]), int(body[2]), int(body[3])
            kpoints.append((ix/idv, iy/idv, iz/idv))
        except ValueError:
            continue

nk = len(kpoints)

# Fallback: try outputkgen for mp_grid if not found in klist
if mp_grid == [1, 1, 1]:
    kgenfile = f"{case}.outputkgen"
    if os.path.exists(kgenfile):
        with open(kgenfile) as f:
            for line in f:
                if 'DIVISION' in line.upper():
                    nums = re.findall(r'\d+', line)
                    if len(nums) >= 3:
                        mp_grid = [int(nums[0]), int(nums[1]), int(nums[2])]
                        break

# ----- Write .win file -----
with open(f"{case}.win", 'w') as f:
    # num_wann placeholder — set to num_atoms for simplicity.
    # wannier90 -pp only needs k-mesh for .nnkp; PDWF patches the
    # real num_wann, num_bands, projections, and windows afterward.
    nat = sum(mult for _, _, _, _, mult in atoms)
    f.write(f"num_bands       = {nb}\n")
    f.write(f"num_wann        = {nat}\n\n")

    f.write(f"!!! Iteration parameters !!!\n")
    f.write(f"iprint                = 1\n")
    f.write(f"num_iter              = 10000\n")
    f.write(f"num_print_cycles      =   100\n")
    f.write(f"conv_window           = 3\n")
    f.write(f"dis_num_iter          = 10000\n\n")

    f.write(f"!!! Post-processing !!!\n")
    f.write(f"write_proj             = .true.\n")
    f.write(f"write_xyz              = .true.\n")
    f.write(f"translate_home_cell    = .true.\n")
    f.write(f"write_hr               = .true.\n\n")

    f.write(f"!!! Band structure !!!\n")
    f.write(f"bands_num_points       = 50\n\n")

    # Unit cell (Bohr)
    f.write(f"begin unit_cell_cart\n")
    f.write(f"Bohr\n")
    for v in prim:
        f.write(f"  {v[0]:14.8f} {v[1]:14.8f} {v[2]:14.8f}\n")
    f.write(f"end unit_cell_cart\n\n")

    # Atoms in Cartesian (Bohr)
    f.write(f"begin atoms_cart\n")
    f.write(f"Bohr\n")
    for iat, x, y, z, mult in atoms:
        cx = x*prim[0][0] + y*prim[1][0] + z*prim[2][0]
        cy = x*prim[0][1] + y*prim[1][1] + z*prim[2][1]
        cz = x*prim[0][2] + y*prim[1][2] + z*prim[2][2]
        f.write(f"  {iat:4d}  {cx:14.8f}  {cy:14.8f}  {cz:14.8f}\n")
    f.write(f"end atoms_cart\n\n")

    # Wien2k conventional → primitive k-point transform
    # Used for both kpoint_path and k-mesh
    if lattype == 'F':
        conv_rec = np.array([[0, 0.5, 0.5], [0.5, 0, 0.5], [0.5, 0.5, 0]])
    elif lattype == 'B':
        conv_rec = np.array([[-0.5, 0.5, 0.5], [0.5, -0.5, 0.5], [0.5, 0.5, -0.5]])
    elif lattype == 'H':
        conv_rec = np.eye(3)
    elif lattype == 'R':
        conv_rec = np.eye(3)  # placeholder
    elif lattype == 'C':
        conv_rec = np.array([[0.5, 0.5, 0], [-0.5, 0.5, 0], [0, 0, 1]])
    else:  # P
        conv_rec = np.eye(3)

    # Band path (optional, from klist_band)
    # Wien2k klist_band uses conventional cell fractional coordinates.
    # Wannier90 needs primitive cell fractional coordinates.
    # Transform using conv_rec (same matrix used for k-mesh below).
    bandfile = f"{case}.klist_band"
    if os.path.exists(bandfile):
        f.write(f"bands_plot = T\n")
        f.write(f"begin kpoint_path\n")
        kpath = []
        with open(bandfile) as bf:
            for line in bf:
                label = line[0:10].strip()
                if not label or label == 'END':
                    continue
                try:
                    body = line[10:].split()
                    if len(body) < 4:
                        continue
                    ix, iy, iz = int(body[0]), int(body[1]), int(body[2])
                    idv = int(body[3])
                    if label and not label.replace('-','').replace('.','').isdigit():
                        k_conv = np.array([ix/idv, iy/idv, iz/idv])
                        k_prim = conv_rec @ k_conv
                        kpath.append((label, *k_prim))
                except (ValueError, IndexError):
                    continue
        for j in range(len(kpath) - 1):
            l1, x1, y1, z1 = kpath[j]
            l2, x2, y2, z2 = kpath[j + 1]
            f.write(f"  {l1:6s} {x1:9.5f} {y1:9.5f} {z1:9.5f}"
                    f"    {l2:6s} {x2:9.5f} {y2:9.5f} {z2:9.5f}\n")
        f.write(f"end kpoint_path\n\n")

    # Dummy projections — one s orbital per atom (= num_wann = nat).
    # Only needed for wannier90 -pp to generate .nnkp.
    # PDWF replaces with real projections and num_wann afterward.
    # Must emit one projection per TOTAL atom (including equivalents).
    f.write(f"guiding_centres = T\n")
    f.write(f"begin projections\n")
    for iat, x, y, z, mult in atoms:
        for mu in range(mult):
            f.write(f"  f={x:.8f},{y:.8f},{z:.8f}:s\n")
    f.write(f"end projections\n\n")

    # K-mesh: transform from Wien2k conventional to primitive fractional
    # using conv_rec defined above.
    f.write(f"mp_grid : {mp_grid[0]} {mp_grid[1]} {mp_grid[2]}\n")
    f.write(f"begin kpoints\n")
    for kx, ky, kz in kpoints:
        kc = np.array([kx, ky, kz])
        kp = conv_rec @ kc
        f.write(f"  {kp[0]:18.15f}  {kp[1]:18.15f}  {kp[2]:18.15f}\n")
    f.write(f"end kpoints\n")

print(f"  wrote {case}.win ({nk} k-points, mp_grid={mp_grid}, "
      f"num_bands={nb})")
PYEOF

[[ -s $winfile ]] || croak "failed to generate $winfile"

[[ $norun ]] && { info "stopping (-norun)"; exit 0; }

# ============================================================
#  Step 3: Run wannier90 -pp  →  .nnkp
# ============================================================
info "Step 3: Running wannier90 -pp"

[[ -n $W90_BIN ]] || croak "cannot find wannier90.x (use -w90exe /path/to/wannier90.x)"
"$W90_BIN" -pp "$file" 2>&1
[[ $? -eq 0 && -s $file.nnkp ]] || croak "wannier90 -pp failed (check $file.wout)"
info "created $file.nnkp"

# ============================================================
#  Step 4: Run w2w/w2wc in PDWF mode
# ============================================================
[[ -n $W2W_BIN ]] || croak "cannot find $w2w_exec (use -w2wdir /path/to/SRC_w2w)"
info "Step 4: Running $w2w_exec (PDWF mode)"

# Create def file for w2w
deffile=w2w.def
cat > "$deffile" <<DEFEOF
  5,'$file.inwf${updn}',       'old',    'formatted',  0
  6,'$file.outputwf${updn}',   'unknown','formatted',  0
  7,'$file.amn',               'unknown','formatted',  0
  8,'$file.mmn',               'unknown','formatted',  0
 10,'$vecfile',                'old','unformatted',     0
 11,'$file.nnkp',              'old',    'formatted',  0
 12,'$file.eig',               'unknown','formatted',  0
 18,'$vspfile',                'old',    'formatted',  0
 20,'$file.struct',            'old',    'formatted',  0
 50,'$enefile',                'old',    'formatted',  0
 51,'$file.fermi',             'old',    'formatted',  0
DEFEOF

"$W2W_BIN" "$deffile" 2>&1
rc=$?

if [[ $rc -ne 0 ]]; then
    croak "$w2w_exec failed (check $file.outputwf${updn})"
fi

# Show PDWF results
outfile=$file.outputwf${updn}
if grep -q "PDWF" "$outfile" 2>/dev/null; then
    info "$w2w_exec completed in PDWF mode"
    echo
    grep -A20 "PDWF Band Classification" "$outfile" 2>/dev/null | head -25
    echo
    grep -A10 "Wannier90 Window" "$outfile" 2>/dev/null | head -12
else
    warn "PDWF output not found in $outfile"
fi

# Verify .win was patched
if grep -q "PDWF auto-generated" "$winfile" 2>/dev/null; then
    info ".win patched with PDWF parameters"
else
    warn ".win was NOT patched — check $file.pdwf_windows"
fi

# ============================================================
#  Step 5: Run wannier90 for Wannierization
# ============================================================
info "Step 5: Running wannier90"

"$W90_BIN" "$file" 2>&1
[[ $? -eq 0 ]] || croak "wannier90 failed (check $file.wout)"

# Report results
woutfile=$file.wout
if grep -q "Final Spread" "$woutfile" 2>/dev/null; then
    echo
    info "=== Wannier90 Results ==="
    grep "Omega" "$woutfile" | tail -4 | while read -r line; do
        info "$line"
    done
    echo
    info "PDWF workflow completed successfully"
    info "Output files:"
    info "  $file.amn           projection matrix"
    info "  $file.mmn           overlap matrix"
    info "  $file.eig           eigenvalues"
    info "  $file.win           Wannier90 input (PDWF-patched)"
    info "  ${file}_hr.dat      Hamiltonian in WF basis"
    [[ -s ${file}_band.dat ]] && \
        info "  ${file}_band.dat    interpolated band structure"
    info "  $file.pdwf_windows  standalone window parameters"
else
    warn "wannier90 completed but Final Spread not found in $woutfile"
fi

exit 0
