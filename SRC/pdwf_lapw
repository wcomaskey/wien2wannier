#!/bin/bash

### wien2wannier/SRC/pdwf_lapw
###
###    Automated PDWF (Projectability-Disentangled Wannier Functions)
###    workflow for wien2wannier.
###
###    One-command pipeline from a completed Wien2k SCF calculation
###    to maximally-localized Wannier functions. No user intervention
###    required — all parameters are determined automatically.
###
###    Self-contained: does NOT depend on Wien2k's x_lapw.
###    Calls w2w/w2wc and wannier90.x directly, so they can be built
###    with independent toolchains (HPC-safe).
###
###    Pipeline:
###      1a. Generate PDWF .inwf
###      1b. Densify klist_band (if present)
###      2.  Generate initial .win from Wien2k files
###      3.  Run wannier90.x -pp  →  .nnkp
###      4.  Run w2wc PDWF mode   →  .amn, .mmn, .eig + patches .win
###      5.  Run wannier90.x      →  Wannierization + band interpolation
###      6.  Generate band comparison plot (if spaghetti available)
###
### Copyright 2024-2026 William Comaskey

set -euo pipefail

bin=$(cd "$(dirname "$0")" && pwd)
name=$(basename "$0")
file=$(basename "$PWD")

# ============================================================
#  Usage
# ============================================================
usage() {
    cat <<EOF
PROGRAM:    $name

PURPOSE:    One-command PDWF Wannierization from a Wien2k calculation.
            Automatically determines projections, energy windows, and
            all Wannier90 parameters. No user intervention required.

USAGE:      $name [FLAGS] [OPTIONS]

FLAGS:
  -h          this message
  -v          verbose output
  -q          quiet mode
  -up/-dn     spin-polarized
  -so         spin-orbit coupling
  -norun      generate input files only (dry run)

OPTIONS:
  -f CASE       override case name (default: directory name)
  -bmin N       minimum band index (default: auto)
  -bmax N       maximum band index (default: auto)
  -ljmax N      max L for exp(ibr) expansion (default: 5)
  -phigh X      frozen percentile 0-1 (default: 0.60)
  -plow X       exclusion percentile 0-1 (default: 0.15)
  -nkband N     k-points per band segment (default: 100)
  -w2wdir DIR   directory containing w2w/w2wc
  -w90exe EXE   path to wannier90.x

PREREQUISITES:
  A completed Wien2k SCF calculation with:
    case.struct   case.klist     case.energy
    case.vector   case.vsp       case.fermi (or case.scf)

  Optional: case.klist_band (for band structure comparison)

EXAMPLES:
  $name                             # fully automatic
  $name -so                         # spin-orbit coupling
  $name -bmin 5 -bmax 22            # explicit band window
  $name -w90exe /opt/wannier90.x    # explicit wannier90 path
  $name -norun                      # just generate input files
EOF
}

# ============================================================
#  Utility functions
# ============================================================
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

croak() { echo -e >&2 "${RED}ERROR:${NC} $*"; exit 1; }
warn()  { [[ ${q:-} ]] && return; echo -e >&2 "${YELLOW}WARNING:${NC} $*"; }
info()  { [[ ${q:-} ]] && return; echo -e "  ${CYAN}>>>${NC} $*"; }
step()  { [[ ${q:-} ]] && return; echo -e "\n${BOLD}Step $1:${NC} $2"; }
done_msg() { echo -e "  ${GREEN}done${NC} $*"; }

# ============================================================
#  Parse options
# ============================================================
unset v q updn so norun
bmin=""
bmax=""
ljmax=5
phigh=0.60
plow=0.15
margin=0.50
nkband=100
w2wdir=""
w90exe=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -[hH]|-help|--help) usage; exit 0;;
        -v|-verbose) v=1;;
        -q|-quiet)   q=1;;
        -up)    updn=up;;
        -dn)    updn=dn;;
        -so)    so=so;;
        -noso)  unset so;;
        -norun) norun=1;;
        -f)      shift; file=$1;;
        -bmin)   shift; bmin=$1;;
        -bmax)   shift; bmax=$1;;
        -ljmax)  shift; ljmax=$1;;
        -phigh)  shift; phigh=$1;;
        -plow)   shift; plow=$1;;
        -margin) shift; margin=$1;;
        -nkband) shift; nkband=$1;;
        -w2wdir) shift; w2wdir=$1;;
        -w90exe) shift; w90exe=$1;;
        -*) croak "unknown option \`$1' (try -h)";;
        *)  croak "unexpected argument \`$1'";;
    esac
    shift
done

echo -e "${BOLD}PDWF Wannierization Pipeline${NC}"
echo -e "case: ${CYAN}$file${NC}"

# ============================================================
#  Detect calculation type
# ============================================================
w2w_exec="w2wc"  # default to complex (safe)

if [[ -s $file.in1c || -n ${so:-} ]]; then
    w2w_exec="w2wc"
elif [[ -s $file.in1 && ! -s $file.in1c ]]; then
    w2w_exec="w2w"
fi

[[ -s $file.inso ]] && so=so

[[ ${v:-} ]] && info "w2w=$w2w_exec sp=${updn:-none} so=${so:-no}"

# ============================================================
#  Resolve executables
# ============================================================
resolve_w2w() {
    local exe=$1
    for dir in "$w2wdir" "$bin/../SRC_w2w" "$bin"; do
        [[ -n $dir && -x "$dir/$exe" ]] && { echo "$dir/$exe"; return 0; }
    done
    command -v "$exe" 2>/dev/null && return 0
    return 1
}

resolve_w90() {
    if [[ -n $w90exe && -x "$w90exe" ]]; then
        echo "$w90exe"; return 0
    fi
    command -v wannier90.x 2>/dev/null && return 0
    command -v wannier90   2>/dev/null && return 0
    return 1
}

W2W_BIN=$(resolve_w2w "$w2w_exec") || true
W90_BIN=$(resolve_w90) || true

[[ ${v:-} ]] && info "w2w: ${W2W_BIN:-(not found)}"
[[ ${v:-} ]] && info "w90: ${W90_BIN:-(not found)}"

# ============================================================
#  Validate prerequisites
# ============================================================
for f in $file.struct $file.klist; do
    [[ -s $f ]] || croak "required file \`$f' not found — run Wien2k SCF first"
done

# Energy file
enefile=""
for suffix in "${so:-}${updn:-}" "${updn:-}" ""; do
    [[ -s "$file.energy$suffix" ]] && { enefile="$file.energy$suffix"; break; }
done
[[ -n $enefile ]] || croak "energy file not found"

# Vector file
vecfile=""
for suffix in "${so:-}${updn:-}" "${updn:-}" ""; do
    [[ -s "$file.vector$suffix" ]] && { vecfile="$file.vector$suffix"; break; }
done
[[ -n $vecfile ]] || croak "vector file not found"

# Potential file
vspfile=""
for suffix in "${updn:-}" ""; do
    [[ -s "$file.vsp$suffix" ]] && { vspfile="$file.vsp$suffix"; break; }
done
[[ -n $vspfile ]] || croak "potential file not found"

# Fermi energy — extract from .scf if .fermi missing
fermifile=$file.fermi
if [[ ! -s $fermifile ]]; then
    if [[ -s $file.scf ]]; then
        grep ':FER' "$file.scf" | tail -1 | awk '{print $NF}' > "$fermifile"
        info "extracted Fermi energy from $file.scf"
    else
        croak "Fermi energy not found (need $file.fermi or $file.scf)"
    fi
fi

info "files: energy=$enefile vector=$vecfile vsp=$vspfile"

# ============================================================
#  Step 0: Auto-detect band window
# ============================================================
# Strategy:
#   1. Read .in1 STOP LO energies to identify semicore boundary
#   2. Read eigenvalues at Gamma from .energy file
#   3. Set bmin = first band ABOVE the semicore boundary
#   4. Set bmax = total number of bands
#
# The .in1 semicore energies are authoritative (set by Wien2k's
# init_lapw). Eigenvalue gaps are used as fallback if no .in1.

nneq=$(sed -n '2p' "$file.struct" | grep -o 'ATOMS[: ]*[0-9]*' | grep -o '[0-9]*$')
[[ -z $nneq ]] && nneq=1
ef_ry=$(cat "$fermifile")

# Find .in1 file (try in1c, in1, with spin suffixes)
in1file=""
for suffix in "c" ""; do
    for sp in "${updn:-}" ""; do
        candidate="$file.in1${suffix}${sp}"
        [[ -s "$candidate" ]] && { in1file="$candidate"; break 2; }
    done
done

# Extract semicore LO energies from .in1
semicore_cutoff_ev=""
if [[ -n $in1file && -s $in1file ]]; then
    semicore_cutoff_ev=$(python3 -c "
ef_ry = $ef_ry
shallowest = None
with open('$in1file') as f:
    for line in f:
        if 'STOP' in line:
            parts = line.split()
            e_ry = float(parts[1])
            e_rel = (e_ry - ef_ry) * 13.605693
            if shallowest is None or e_rel > shallowest:
                shallowest = e_rel
if shallowest is not None:
    print(f'{shallowest:.4f}')
else:
    print('')
" 2>/dev/null)
    [[ -n $semicore_cutoff_ev ]] && \
        info "semicore boundary from .in1: ${semicore_cutoff_ev} eV (rel to E_F)"
fi

if [[ -z $bmin || -z $bmax ]]; then
    read_result=$(python3 -c "
nneq = $nneq
ef_ry = $ef_ry
semicore_cutoff = '${semicore_cutoff_ev}'

with open('$enefile') as f:
    for _ in range(2 * nneq):
        f.readline()
    header = f.readline()
    nen = int(header[73:79])
    eigs_ry = []
    for i in range(nen):
        parts = f.readline().split()
        eigs_ry.append(float(parts[1]))

eigs_ev = [(e - ef_ry) * 13.605693 for e in eigs_ry]

# Determine bmin: skip only DEEP CORE bands.
#
# Strategy: only exclude bands that are clearly deep core —
# i.e. separated from the rest by a very large gap (> 20 eV).
# Semicore bands (like Mg 2p) are kept in the window and handled
# by classify_bands in w2w via its gap-based detector. This is
# important because the classify_bands gap detector also sets the
# sigma for the split Gaussian weighting, which needs to see the
# full valence+semicore spectrum to produce good results.
#
# The .in1 STOP LO info is logged for diagnostics but does NOT
# drive the bmin decision — it's used by classify_bands instead.

bmin = 1
method = 'none'
# Find the FIRST gap > 20 eV below E_F (deep core boundary).
# Only skip bands below this gap; semicore bands above it are
# passed to classify_bands which handles them properly.
for i in range(len(eigs_ev) - 1):
    if eigs_ev[i] < 0:
        gap = eigs_ev[i+1] - eigs_ev[i]
        if gap > 20.0:
            bmin = i + 2  # 1-indexed, first band after gap
            method = f'core gap ({gap:.1f} eV at band {i+1})'
            break  # take the FIRST large gap only

bmax = len(eigs_ry)

print(f'{bmin} {bmax} {method}')
if bmin > 1:
    print(f'  band {bmin-1}: E={eigs_ev[bmin-2]:.2f} eV (excluded)')
    print(f'  band {bmin}: E={eigs_ev[bmin-1]:.2f} eV (first included)')
" 2>&1)

    bmin_auto=$(echo "$read_result" | head -1 | awk '{print $1}')
    bmax_auto=$(echo "$read_result" | head -1 | awk '{print $2}')
    method_auto=$(echo "$read_result" | head -1 | cut -d' ' -f3-)

    [[ -z $bmin_auto || -z $bmax_auto ]] && croak "could not auto-detect band window"

    [[ -z $bmin ]] && bmin=$bmin_auto
    [[ -z $bmax ]] && bmax=$bmax_auto

    info "band window: [$bmin, $bmax] ($bmax_auto total bands)"
    info "bmin method: $method_auto"
    # Print boundary info
    echo "$read_result" | tail -n +2 | while read -r line; do
        [[ -n "$line" ]] && info "$line"
    done
fi

nb=$((bmax - bmin + 1))

# ============================================================
#  Step 1a: Generate PDWF .inwf
# ============================================================
step "1a" "Generating PDWF input (.inwf)"

inwffile=$file.inwf${updn:-}
cat > "$inwffile" <<EOF
PDWF
 $bmin  $bmax
 $ljmax
 $phigh  $plow  $margin
EOF
done_msg "$inwffile"

# ============================================================
#  Step 1b: Densify klist_band (if present)
# ============================================================
klistband=$file.klist_band
if [[ -s $klistband ]]; then
    step "1b" "Densifying band k-path ($nkband pts/segment)"
    python3 - "$file" "$nkband" <<'KBEOF'
import sys, re
import numpy as np

case, npts = sys.argv[1], int(sys.argv[2])

labels = []
with open(f"{case}.klist_band") as f:
    for line in f:
        s = line.strip()
        if s == 'END' or not s:
            continue
        label = line[0:10].strip()
        if not label or label.replace('-','').replace('.','').isdigit():
            continue
        body = line[10:].split()
        if len(body) < 4:
            continue
        ix, iy, iz, idv = int(body[0]), int(body[1]), int(body[2]), int(body[3])
        labels.append((label, np.array([ix/idv, iy/idv, iz/idv])))

if len(labels) < 2:
    sys.exit(0)

import shutil
shutil.copy(f"{case}.klist_band", f"{case}.klist_band.orig")
div = npts * 6

with open(f"{case}.klist_band", 'w') as f:
    for iseg in range(len(labels) - 1):
        l1, k1 = labels[iseg]
        l2, k2 = labels[iseg + 1]
        for i in range(npts + 1):
            if i == 0 and iseg > 0:
                continue
            t = i / npts
            kp = k1 + t * (k2 - k1)
            ix = int(round(kp[0] * div))
            iy = int(round(kp[1] * div))
            iz = int(round(kp[2] * div))
            if (i == 0) or (i == npts and iseg == len(labels) - 2):
                lbl = l1 if i == 0 else l2
                erange = '-8.00 8.00' if (iseg == 0 and i == 0) else ''
                f.write(f"{lbl:10s}{ix:5d}{iy:5d}{iz:5d}{div:5d}  2.0{erange}\n")
            elif i == npts:
                f.write(f"{l2:10s}{ix:5d}{iy:5d}{iz:5d}{div:5d}  2.0\n")
            else:
                f.write(f"{'':10s}{ix:5d}{iy:5d}{iz:5d}{div:5d}  2.0\n")
    f.write("END\n")

total = sum(1 for _ in open(f"{case}.klist_band") if _.strip() and _.strip() != 'END')
print(f"  {total} k-points ({npts}/segment)")
KBEOF
fi

# ============================================================
#  Step 2: Generate initial .win
# ============================================================
step "2" "Generating Wannier90 input (.win)"

winfile=$file.win

python3 - "$file" "$bmin" "$bmax" <<'PYEOF'
import sys, os, re, math
import numpy as np

case = sys.argv[1]
bmin, bmax = int(sys.argv[2]), int(sys.argv[3])
nb = bmax - bmin + 1

# ----- Parse struct -----
with open(f"{case}.struct") as f:
    slines = f.readlines()

lattype = slines[1][0:1].strip()
nneq_match = re.search(r'ATOMS[:\s]+(\d+)', slines[1])
nneq = int(nneq_match.group(1)) if nneq_match else int(slines[1].split()[3])
latline = slines[3]
a = [float(latline[i:i+10]) for i in range(0, 60, 10)]

atoms = []
i = 4
for iat in range(nneq):
    pos = slines[i]
    x = float(pos[12:22])
    y = float(pos[25:35])
    z = float(pos[38:48])
    i += 1
    mult = int(slines[i].split('=')[1].split()[0])
    i += 1 + (mult - 1) + 1 + 3  # MULT + equiv + element + rot
    atoms.append((iat + 1, x, y, z, mult))

# ----- Primitive lattice vectors (Bohr) -----
a1, a2, a3 = a[0], a[1], a[2]
alpha, beta, gamma = [a[i+3] * math.pi / 180 for i in range(3)]

if lattype == 'F':
    prim = [[0, a2/2, a3/2], [a1/2, 0, a3/2], [a1/2, a2/2, 0]]
elif lattype == 'B':
    prim = [[-a1/2, a2/2, a3/2], [a1/2, -a2/2, a3/2], [a1/2, a2/2, -a3/2]]
elif lattype == 'H':
    prim = [[a1, 0, 0], [-a1/2, a2*math.sqrt(3)/2, 0], [0, 0, a3]]
elif lattype == 'R':
    tx = a1 * math.sqrt((1 - math.cos(alpha)) / 2)
    tz = a1 * math.sqrt((1 + 2 * math.cos(alpha)) / 3)
    ty1 = a1 * math.sqrt((1 - math.cos(alpha)) / 6)
    prim = [[tx, -ty1, tz/3], [0, 2*ty1, tz/3], [-tx, -ty1, tz/3]]
elif lattype == 'C':
    prim = [[a1/2, -a2/2, 0], [a1/2, a2/2, 0], [0, 0, a3]]
else:
    sg, cg = math.sin(gamma), math.cos(gamma)
    cb, ca = math.cos(beta), math.cos(alpha)
    prim = [
        [a1, 0, 0], [a2*cg, a2*sg, 0],
        [a3*cb, a3*(ca - cb*cg)/sg,
         a3*math.sqrt(1 - ca**2 - cb**2 - cg**2 + 2*ca*cb*cg)/sg]
    ]

# ----- conv_rec for k-point transformation -----
if lattype == 'F':
    conv_rec = np.array([[0, 0.5, 0.5], [0.5, 0, 0.5], [0.5, 0.5, 0]])
elif lattype == 'B':
    conv_rec = np.array([[-0.5, 0.5, 0.5], [0.5, -0.5, 0.5], [0.5, 0.5, -0.5]])
elif lattype in ('H', 'R', 'P', 'S'):
    conv_rec = np.eye(3)
elif lattype == 'C':
    conv_rec = np.array([[0.5, 0.5, 0], [-0.5, 0.5, 0], [0, 0, 1]])
else:
    conv_rec = np.eye(3)

# ----- Parse klist -----
kpoints, mp_grid = [], [1, 1, 1]
with open(f"{case}.klist") as f:
    for line in f:
        s = line.strip()
        if s.startswith('END') or not s:
            break
        div_match = re.search(r'div:\s*\(\s*(\d+)\s+(\d+)\s+(\d+)\s*\)', line)
        if div_match:
            mp_grid = [int(div_match.group(i)) for i in (1, 2, 3)]
        body = line[10:].split()
        if len(body) < 4:
            continue
        try:
            ix, iy, iz, idv = int(body[0]), int(body[1]), int(body[2]), int(body[3])
            kpoints.append((ix/idv, iy/idv, iz/idv))
        except ValueError:
            continue

if mp_grid == [1, 1, 1]:
    kgenfile = f"{case}.outputkgen"
    if os.path.exists(kgenfile):
        with open(kgenfile) as f:
            for line in f:
                if 'DIVISION' in line.upper():
                    nums = re.findall(r'\d+', line)
                    if len(nums) >= 3:
                        mp_grid = [int(n) for n in nums[:3]]
                        break

# ----- Write .win -----
nat = sum(m for _, _, _, _, m in atoms)
with open(f"{case}.win", 'w') as f:
    f.write(f"num_bands       = {nb}\n")
    f.write(f"num_wann        = {nat}\n\n")
    f.write(f"iprint                = 1\n")
    f.write(f"num_iter              = 10000\n")
    f.write(f"num_print_cycles      =   100\n")
    f.write(f"conv_window           = 3\n")
    f.write(f"dis_num_iter          = 10000\n\n")
    f.write(f"write_proj             = .true.\n")
    f.write(f"write_xyz              = .true.\n")
    f.write(f"translate_home_cell    = .true.\n")
    f.write(f"write_hr               = .true.\n\n")
    f.write(f"bands_num_points       = 50\n\n")

    f.write(f"begin unit_cell_cart\nBohr\n")
    for v in prim:
        f.write(f"  {v[0]:14.8f} {v[1]:14.8f} {v[2]:14.8f}\n")
    f.write(f"end unit_cell_cart\n\n")

    f.write(f"begin atoms_cart\nBohr\n")
    for iat, x, y, z, mult in atoms:
        cx = x*prim[0][0] + y*prim[1][0] + z*prim[2][0]
        cy = x*prim[0][1] + y*prim[1][1] + z*prim[2][1]
        cz = x*prim[0][2] + y*prim[1][2] + z*prim[2][2]
        f.write(f"  {iat:4d}  {cx:14.8f}  {cy:14.8f}  {cz:14.8f}\n")
    f.write(f"end atoms_cart\n\n")

    # Band path (conv_rec transform from Wien2k conventional to primitive)
    bandfile = f"{case}.klist_band"
    if os.path.exists(bandfile):
        kpath = []
        with open(bandfile) as bf:
            for line in bf:
                label = line[0:10].strip()
                if not label or label == 'END':
                    continue
                body = line[10:].split()
                if len(body) < 4:
                    continue
                try:
                    ix, iy, iz = int(body[0]), int(body[1]), int(body[2])
                    idv = int(body[3])
                    if label and not label.replace('-','').replace('.','').isdigit():
                        k_prim = conv_rec @ np.array([ix/idv, iy/idv, iz/idv])
                        kpath.append((label, *k_prim))
                except (ValueError, IndexError):
                    continue
        if len(kpath) >= 2:
            f.write(f"bands_plot = T\nbegin kpoint_path\n")
            for j in range(len(kpath) - 1):
                l1, x1, y1, z1 = kpath[j]
                l2, x2, y2, z2 = kpath[j + 1]
                f.write(f"  {l1:6s} {x1:9.5f} {y1:9.5f} {z1:9.5f}"
                        f"    {l2:6s} {x2:9.5f} {y2:9.5f} {z2:9.5f}\n")
            f.write(f"end kpoint_path\n\n")

    # Dummy projections (PDWF patches later)
    f.write(f"guiding_centres = T\nbegin projections\n")
    for iat, x, y, z, mult in atoms:
        for mu in range(mult):
            f.write(f"  f={x:.8f},{y:.8f},{z:.8f}:s\n")
    f.write(f"end projections\n\n")

    # K-mesh (transformed)
    f.write(f"mp_grid : {mp_grid[0]} {mp_grid[1]} {mp_grid[2]}\n")
    f.write(f"begin kpoints\n")
    for kx, ky, kz in kpoints:
        kp = conv_rec @ np.array([kx, ky, kz])
        f.write(f"  {kp[0]:18.15f}  {kp[1]:18.15f}  {kp[2]:18.15f}\n")
    f.write(f"end kpoints\n")

nk = len(kpoints)
print(f"  {nk} k-points, mp_grid={mp_grid}, {nb} bands")
PYEOF

[[ -s $winfile ]] || croak "failed to generate $winfile"
done_msg "$winfile"

[[ ${norun:-} ]] && { info "stopping (-norun)"; exit 0; }

# ============================================================
#  Step 3: Run wannier90 -pp → .nnkp
# ============================================================
step "3" "Running wannier90 -pp"

[[ -n $W90_BIN ]] || croak "cannot find wannier90.x (use -w90exe)"
"$W90_BIN" -pp "$file" 2>&1
[[ $? -eq 0 && -s $file.nnkp ]] || croak "wannier90 -pp failed (check $file.wout)"
done_msg "$file.nnkp"

# ============================================================
#  Step 4: Run w2w/w2wc in PDWF mode
# ============================================================
step "4" "Running $w2w_exec (PDWF mode)"

[[ -n $W2W_BIN ]] || croak "cannot find $w2w_exec (use -w2wdir)"

cat > w2w.def <<DEFEOF
  5,'$file.inwf${updn:-}',       'old',    'formatted',  0
  6,'$file.outputwf${updn:-}',   'unknown','formatted',  0
  7,'$file.amn',               'unknown','formatted',  0
  8,'$file.mmn',               'unknown','formatted',  0
 10,'$vecfile',                'old','unformatted',     0
 11,'$file.nnkp',              'old',    'formatted',  0
 12,'$file.eig',               'unknown','formatted',  0
 18,'$vspfile',                'old',    'formatted',  0
 20,'$file.struct',            'old',    'formatted',  0
 50,'$enefile',                'old',    'formatted',  0
 51,'$file.fermi',             'old',    'formatted',  0
DEFEOF

"$W2W_BIN" w2w.def 2>&1
[[ $? -eq 0 ]] || croak "$w2w_exec failed (check $file.outputwf${updn:-})"

# Show summary
outfile=$file.outputwf${updn:-}
if grep -q "PDWF" "$outfile" 2>/dev/null; then
    echo
    grep "PDWF:" "$outfile" | while read -r line; do echo "  $line"; done
    echo
    grep -A20 "PDWF Band Classification" "$outfile" | head -25
    echo
    grep -A8 "Wannier90 Window" "$outfile" | head -10
fi

# Verify .win patched
if grep -q "PDWF auto-generated" "$winfile" 2>/dev/null; then
    done_msg ".win patched with PDWF parameters"
else
    warn ".win NOT patched — check $file.pdwf_windows"
fi

# ============================================================
#  Step 5: Run wannier90
# ============================================================
step "5" "Running wannier90 (Wannierization + band interpolation)"

"$W90_BIN" "$file" 2>&1
[[ $? -eq 0 ]] || croak "wannier90 failed (check $file.wout)"

# Report results
woutfile=$file.wout
if grep -q "Final Spread" "$woutfile" 2>/dev/null; then
    echo
    echo -e "  ${BOLD}=== Wannier90 Results ===${NC}"
    grep "Omega" "$woutfile" | tail -4 | while read -r line; do
        echo "  $line"
    done
    echo
fi

# ============================================================
#  Step 6: Band comparison (if spaghetti available)
# ============================================================
if [[ -s $file.spaghetti_ene && -s ${file}_band.dat ]]; then
    step "6" "Generating band comparison plot"
    if [[ -x "$bin/compare_bands.py" ]]; then
        python3 "$bin/compare_bands.py" "$file" -dir . 2>&1
    elif command -v python3 &>/dev/null; then
        info "compare_bands.py not found at $bin — skipping plot"
    fi
fi

# ============================================================
#  Summary
# ============================================================
echo
echo -e "${BOLD}PDWF workflow completed successfully${NC}"
echo
echo "  Output files:"
echo "    $file.amn             projection matrix"
echo "    $file.mmn             overlap matrix"
echo "    $file.eig             eigenvalues"
echo "    $file.win             Wannier90 input (PDWF-patched)"
echo "    ${file}_hr.dat        Hamiltonian in WF basis"
[[ -s ${file}_band.dat ]] && \
echo "    ${file}_band.dat      interpolated band structure"
echo "    $file.pdwf_windows    standalone window parameters"
echo "    $file.outputwf        PDWF diagnostics"
echo

exit 0
