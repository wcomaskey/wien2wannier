class CliError(RuntimeError):
    """An actionable user-facing CLI error."""


class GroupedHelpFormatter(argparse.RawDescriptionHelpFormatter):
    """Keep examples readable while retaining argparse's option wrapping."""

    def _format_action_invocation(self, action: argparse.Action) -> str:
        if not action.option_strings:
            return super()._format_action_invocation(action)
        if action.nargs == 0:
            return ", ".join(action.option_strings)
        metavar = self._format_args(action, action.dest.upper())
        return ", ".join(action.option_strings) + " " + metavar


class ConsistentStoreAction(argparse.Action):
    """Allow equivalent aliases while rejecting contradictory repetitions."""

    def __call__(self, parser: argparse.ArgumentParser, namespace: argparse.Namespace, values: object, option_string: str | None = None) -> None:
        previous = getattr(namespace, self.dest, None)
        if previous is not None and previous != values:
            parser.error(
                f"conflicting values for {option_string or self.dest}: "
                f"already selected {previous}, then received {values}"
            )
        setattr(namespace, self.dest, values)


def _git_revision_from(directory: Path) -> str | None:
    """Read a nearby Git revision without requiring the git executable."""
    marker = directory / ".git"
    if not marker.exists():
        return None
    gitdir = marker
    if marker.is_file():
        text = marker.read_text(errors="replace").strip()
        if not text.startswith("gitdir:"):
            return None
        gitdir = Path(text.split(":", 1)[1].strip())
        if not gitdir.is_absolute():
            gitdir = (directory / gitdir).resolve()
    head = gitdir / "HEAD"
    if not head.is_file():
        return None
    value = head.read_text(errors="replace").strip()
    if not value.startswith("ref:"):
        return value[:12] if re.fullmatch(r"[0-9a-fA-F]{12,40}", value) else None
    ref = value.split(None, 1)[1]
    ref_roots = [gitdir]
    commondir_file = gitdir / "commondir"
    if commondir_file.is_file():
        common = Path(commondir_file.read_text(errors="replace").strip())
        if not common.is_absolute():
            common = (gitdir / common).resolve()
        ref_roots.append(common)
    for ref_root in ref_roots:
        loose = ref_root / ref
        if loose.is_file():
            return loose.read_text(errors="replace").strip()[:12]
        packed = ref_root / "packed-refs"
        if packed.is_file():
            for line in packed.read_text(errors="replace").splitlines():
                fields = line.split()
                if len(fields) == 2 and fields[1] == ref:
                    return fields[0][:12]
    return None


def source_revision() -> str:
    here = Path(__file__).resolve().parent
    for directory in (here.parent, here):
        revision = _git_revision_from(directory)
        if revision:
            return revision
    if not ARCHIVE_REVISION.startswith("$Format"):
        return f"{ARCHIVE_REVISION[:12]} (release archive)"
    return "unavailable (installed copy)"


def detected_capabilities() -> str:
    here = Path(__file__).resolve().parent
    directories = [here, here.parent / "SRC_w2w"]
    wienroot = os.environ.get("WIENROOT")
    if wienroot:
        directories.append(Path(wienroot).expanduser())
    names = ("w2w", "w2wc", "w2w_mpi", "w2w_mpic", "w2w_hybrid", "w2w_hybrid_acc")
    detected = []
    for name in names:
        found = locate_executable(name, directories)
        if found:
            detected.append(name if found[1] == name else f"{name} (as {found[1]})")
    return ", ".join(detected) if detected else "none on current PATH/install directory"


def version_text() -> str:
    return (
        f"wien2wannier {VERSION}\n"
        f"source revision: {source_revision()}\n"
        "supported: integrated real/complex/SOC; serial, threaded-library, and MPI resources; "
        "standalone AMN/MMN bridge (serial or OpenMP build)\n"
        f"detected backends: {detected_capabilities()}"
    )


