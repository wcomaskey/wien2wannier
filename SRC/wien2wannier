def positive_int(text: str) -> int:
    try:
        value = int(text)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("want an integer") from exc
    if value < 1:
        raise argparse.ArgumentTypeError("want a positive integer")
    return value


def froz_emax_value(text: str) -> float | str:
    """--froz-emax: a ceiling in eV above E_F, or `auto` (walked down from E_F+8 eV, the published release
    protocol) or `none` (no ceiling). The words are passed to the backend unchanged; they need --num-wann."""
    word = text.strip().lower()
    if word in ("auto", "none"):
        return word
    try:
        return float(text)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("want a ceiling in eV, auto, or none") from exc


def froz_emax_text(value: float | str) -> str:
    return value if isinstance(value, str) else f"{value} eV"


def nonnegative_int(text: str) -> int:
    try:
        value = int(text)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("want an integer") from exc
    if value < 0:
        raise argparse.ArgumentTypeError("want an integer >= 0")
    return value


