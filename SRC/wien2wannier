    vsp2: Path | None = None
    inso: Path | None = None
    win: Path | None = None
    nnkp: Path | None = None


@dataclass(frozen=True)
class ResourcePlan:
    mode: str
    threads: int
    mpi_ranks: int
    backend: Path | None
    launcher: Path | None = None
    launcher_args: tuple[str, ...] = ()
    binding: str = ""

    def command(self, arguments: Sequence[str]) -> list[str]:
        if self.backend is None:
            return []
        base = [str(self.backend), *arguments]
        if self.mode == "mpi":
            if self.launcher is None:
                raise CliError("internal error: MPI resource plan lacks a launcher")
            return [str(self.launcher), "-n", str(self.mpi_ranks), *self.launcher_args, *base]
        return base


